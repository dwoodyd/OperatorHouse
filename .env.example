# Operator House Environment Variables

# Database
DATABASE_URL=mysql://user:pass@host:3306/operatorhouse

# Auth
JWT_SECRET=your-jwt-secret-here
OAUTH_SERVER_URL=https://auth.yourdomain.com
APP_ID=your-app-id

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM="DeWayne Woods <dewayne@operatorhouse.click>"

# Public URL
PUBLIC_URL=https://app.operatorhouse.click

# Manus Forge (for storage/AI)
BUILT_IN_FORGE_API_URL=https://forge.yourdomain.com
BUILT_IN_FORGE_API_KEY=your-forge-api-key

# PayPal (for billing)
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-secret
PAYPAL_PLAN_OPERATOR=your-operator-plan-id
PAYPAL_PLAN_OPERATOR_PRO=your-pro-plan-id

# Stripe (alternative billing)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_MONTHLY_PRICE_ID=price_xxxxxxxxxxxxxxxx
STRIPE_ANNUAL_PRICE_ID=price_xxxxxxxxxxxxxxxx

# Twilio (for SMS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Vapi (for voice AI)
VAPI_API_KEY=your-vapi-api-key

# Web Push
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
